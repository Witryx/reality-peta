# Local development: durable embedded PostgreSQL, no Docker required.
# NEVER enable LOCAL_DATABASE in production.
LOCAL_DATABASE=1
APP_URL=http://localhost:3000
VITE_SITE_URL=
UPLOAD_DIR=./uploads
# Production / external PostgreSQL:
# LOCAL_DATABASE=0
# DATABASE_URL=postgres://realty:strong-password@localhost:5432/realty
# APP_URL=https://your-domain.cz
# VITE_SITE_URL=https://your-domain.cz
# Original brand media migration only:
# ASSET_ORIGIN=https://your-old-lovable-site.lovable.app
