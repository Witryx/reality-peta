    "groups": ["Úvodní stránka", "Kontakt – vyhledávače", "Kontakt", "Identita"]
  },
  {
    "key": "text_8abcf143",
    "default": "Pojďme si promluvit",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_9c2d016e",
    "default": "Zavolejte, napište nebo vyplňte formulář. Ozvu se osobně.",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_26f24eff",
    "default": "Odeslat zprávu",
    "groups": ["Úvodní stránka", "Kontakt"]
  },
  {
    "key": "text_292cb62e",
    "default": "Kontaktujte realitního makléře Petra Pavláta – telefon, e-mail, WhatsApp nebo kontaktní formulář.",
    "groups": ["Kontakt – vyhledávače"]
  },
  {
