  {
    "key": "text_cd10f9a8",
    "default": "Co najdete v okolí",
    "groups": ["Okolí nemovitosti"]
  },
  {
    "key": "text_b4013e55",
    "default": "Důležitá místa a vzdálenosti od nemovitosti.",
    "groups": ["Okolí nemovitosti"]
  },
  {
    "key": "text_81c97f33",
    "default": "cs-CZ",
    "groups": ["Okolí nemovitosti"]
  },
  {
    "key": "text_7d605fc6",
    "default": "Vzdálenosti jsou orientační. U každého místa je uvedeno, zda jde o pěší trasu, nebo vzdálenost vzdušnou čarou.",
    "groups": ["Okolí nemovitosti"]
  },
  {
    "key": "text_df8a3c78",
    "default": "Fotografii připravujeme",
    "groups": ["Nabídka"]
  },
  {
    "key": "text_c8d7259a",
    "default": "Ukázka",
    "groups": ["Nabídka"]
  },
  {
    "key": "text_880a93ac",
    "default": "Detail nabídky",
    "groups": ["Nabídka"]
  },
  {
    "key": "text_ed900127",
    "default": "Nové nabídky pro vás právě připravuji. Mezitím mi napište, jakou nemovitost hledáte.",
    "groups": ["Nabídka"]
  },
  {
    "key": "text_b4aab7f6",
    "default": "Předchozí nemovitost",
    "groups": ["Nabídka"]
  },
  {
    "key": "text_2e709346",
    "default": "Další nemovitost",
    "groups": ["Nabídka"]
  },
  {
    "key": "text_50e35230",
    "default": "Ukázková reference",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_a828a98a",
    "default": "První krok k dobrému rozhodnutí",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_9487b18",
    "default": "Chci znát cenu",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_f77f5760",
    "default": "své nemovitosti.",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_d2491a18",
    "default": "Pro nové klienty připravím odhad nemovitosti",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_c501ef30",
    "default": "zdarma.",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_626bf6ab",
    "default": "Napište mi pár základních údajů. Zjistíme reálnou cenu podle skutečných prodejů v okolí — nezávazně a diskrétně.",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_5d501bac",
    "default": "Odpověď obvykle do dvou pracovních dnů",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_4c0b2e49",
    "default": "Bez závazků. Bez nátlaku.",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_56d30349",
    "default": "Získat odhad nemovitosti zdarma",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_a03d3eee",
    "default": "O mně",
    "groups": ["Společné sekce", "Identita"]
  },
  {
    "key": "text_173df481",
    "default": "Reality jsou pro mě o lidech.",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_e52421b",
    "default": "Práce s lidmi mě baví a naplňuje. Právě při ní můžu naplno využít své schopnosti a pomáhat s rozhodnutími, která mají v životě skutečnou váhu.",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_3dae21c7",
    "default": "Největší smysl mi dává, když celý postup dává smysl i vám. Když přinese klid, radost z nového bydlení nebo řešení důležité situace — a posune vás blíž k tomu, co od života chcete. Nemovitost je součást příběhu. Základem je pro mě lidský přístup.",
    "groups": ["Společné sekce"]
  },
  {
    "key": "text_bb9bc319",
