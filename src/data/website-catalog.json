  {
    "key": "text_92ef4d3c",
    "default": "Pomozte mi dělat web užitečnější",
    "groups": ["Cookies"]
  },
  {
    "key": "text_925ac7ad",
    "default": "S vaším souhlasem zjistím, které nabídky a informace jsou pro vás užitečné. Nezbytné technologie potřebuji pro správné fungování webu. Analytiku a marketing zapnu až s vaším souhlasem. Volbu můžete kdykoli změnit.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_53d59aae",
    "default": "Zajišťují správné fungování webu a uložení vaší volby. Jsou vždy aktivní.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_ce76eca",
    "default": "Pomáhají mi obecně zjistit návštěvnost a zájem o obsah. Zapnou se jen s vaším souhlasem.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_d5421228",
    "default": "Marketingové a externí obsah",
    "groups": ["Cookies"]
  },
  {
    "key": "text_8c7b7727",
    "default": "Umožní načíst Google Mapy, videa YouTube / Vimeo, virtuální prohlídky Matterport a měření reklam Google a Meta. Zapnou se jen s vaším souhlasem.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_33508c48",
    "default": "Povolit vše",
    "groups": ["Cookies"]
  },
