  {
    "key": "text_e5612887",
    "default": "Tato nabídka už není dostupná. Napište mi, co hledáte – dám vědět jako prvním.",
    "groups": ["Detail nemovitosti"]
  },
  {
    "key": "text_bfde9286",
    "default": "Rád vám nemovitost ukážu osobně.",
    "groups": ["Detail nemovitosti"]
  },
  {
    "key": "text_e82ba952",
