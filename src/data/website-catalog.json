    "groups": ["Navigace"]
  },
  {
    "key": "text_de98c133",
    "default": "Články pro klienty",
    "groups": ["Články – vyhledávače"]
  },
  {
    "key": "text_6df2ddaf",
    "default": "Informace a upozornění pro majitele nemovitostí: daň z nemovitosti, PNB a předání, hypotéky a úrokové sazby, bezpečný převod peněz.",
    "groups": ["Články – vyhledávače"]
  },
  {
    "key": "text_f15defa8",
    "default": "Při prodeji, koupi i vlastnictví nemovitosti je potřeba hlídat spoustu povinností. Tady najdete přehledně shrnuté, co se klientů nejčastěji týká — daň z nemovitosti, předání, hypotéky i peníze.",
    "groups": ["Články"]
  },
  {
    "key": "text_8f454525",
    "default": "Číst",
    "groups": ["Články"]
  },
  {
    "key": "text_eeb815cc",
    "default": "Články mají obecný informační charakter a nenahrazují daňové ani právní poradenství. U konkrétní nemovitosti vždy ověřte aktuální podmínky.",
    "groups": ["Články"]
  },
  {
    "key": "text_b98d29",
    "default": "Tento článek už tu není.",
    "groups": ["Články"]
  },
  {
    "key": "text_a7b94aa9",
    "default": "Zpět na články",
    "groups": ["Články"]
  },
  {
    "key": "text_6846a75a",
    "default": "Máte dotaz k tomu, co jste si přečetli?",
    "groups": ["Články"]
  },
  {
    "key": "text_a8b8e314",
    "default": "Rád to s vámi projdu osobně — i u vaší konkrétní nemovitosti. Zavolejte nebo napište.",
    "groups": ["Články"]
  },
  {
    "key": "text_915bb29b",
    "default": "Kontaktovat Petra",
    "groups": ["Články"]
  },
  {
    "key": "text_2fd0bf5a",
    "default": "Prodej nemovitosti",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_5620ddd9",
    "default": "Od reálné ceny až po předání klíčů. Srozumitelně, osobně a bez zbytečného tlaku.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_deb843f8",
    "default": "Společně stanovíme cenu, časový plán a způsob prezentace. Postarám se o zájemce, vyjednávání a koordinaci smluv i předání.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_b90fd83",
    "default": "Koupě",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_22356612",
    "default": "Domov, který vám bude sedět. Pomohu s výběrem, prověřením i vyjednáváním.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_2e144c21",
    "default": "Probereme vaše potřeby a rozpočet, projdeme dostupné možnosti i rizika. Rozhodnutí zůstává vždy na vás, bez tlaku na rychlou koupi.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_2ddc41ab",
    "default": "Pronájem",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_b6df7237",
    "default": "Spolehlivý nájemník, jasná smlouva a klidnější správa vašeho majetku.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_8adc5c7b",
    "default": "Připravím nabídku, koordinuji prohlídky a pomohu prověřit zájemce. Ve spolupráci s právníkem zajistíme smlouvu a předávací protokol.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_d4516fdf",
    "default": "Odhad a využití majetku",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_89030f2b",
    "default": "Kolik má nemovitost hodnotu a jaké možnosti vám může otevřít?",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_ea1a5fd8",
    "default": "Odhad vychází ze skutečných prodejů v konkrétní lokalitě. Probereme prodej, pronájem i další využití majetku, včetně nákladů a rizik, bez slibů zaručeného zhodnocení.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_893f6397",
    "default": "Prezentace a marketing",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_aeda6c5d",
    "default": "Fotografie, video a promyšlená příprava. Nemovitost ukážeme pravdivě a kvalitně.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_af3a8ead",
    "default": "Navrhnu úpravy, které mají smysl. Kvalitní fotografie, virtuální prohlídka a cílená prezentace pomohou oslovit relevantní zájemce.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_8480ee5",
    "default": "Právní a hypoteční servis",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_b6222f53",
    "default": "Odborníci, jasné smlouvy a bezpečný postup při zásadním životním rozhodnutí.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_31ff15cd",
    "default": "Ve spolupráci s advokáty a hypotečními specialisty projdeme financování, úschovu i převod. Podmínky a související náklady si vysvětlíme předem.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_869f5fa0",
    "default": "Nezávazná schůzka",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_fb8e4ef3",
    "default": "Poznáme se, prohlédnu nemovitost a probereme vaše představy i časový plán.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_82b5ef37",
    "default": "Cena a strategie",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_497e31d3",
    "default": "Připravím analýzu trhu a navrhnu cenu i způsob prodeje, který dává smysl.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_6b5f3601",
    "default": "Příprava a prezentace",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_aa498825",
    "default": "Homestaging, fotografie, video a texty. Nemovitost ukážeme v nejlepším světle.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_1efcba93",
    "default": "Prohlídky a vyjednávání",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_7dfaadd9",
    "default": "Prověřím zájemce, vedu prohlídky a vyjednám nejlepší podmínky.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_a1e83519",
    "default": "Smlouvy a předání",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_11a945ad",
    "default": "Právní servis, úschova kupní ceny, převod na katastru a předání klíčů.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_412ba249",
    "default": "Jana a Martin",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_78944ef1",
    "default": "Prodej bytu 3+1, Praha 3",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_96e2816c",
    "default": "Petr nám vysvětlil každý krok a byl vždy k zastižení. Prodej proběhl rychleji, než jsme čekali, a bez jediného stresu.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_f548022e",
    "default": "Tomáš K.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_b4891857",
    "default": "Koupě domu, Praha-západ",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_96fd4394",
    "default": "Oceňuji, že nám nic netlačil. Upozornil i na věci, které by nám jiný makléř raději zamlčel.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_c150daa2",
    "default": "Eva S.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_ec97308e",
    "default": "Pronájem bytu, Praha 7",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_f2842dcd",
    "default": "Lidský přístup a profesionální výsledek. Nájemníka jsme měli do dvou týdnů.",
    "groups": ["Služby a reference"]
  },
  {
    "key": "text_c8f9b370",
    "default": "Petr Pavlát reality",
    "groups": ["Identita"]
  },
  {
    "key": "text_ca3b48a4",
    "default": "Bydlení v pohodě. U nás i u moře.",
    "groups": ["Identita"]
  },
  {
    "key": "text_30deb718",
    "default": "Petr Pavlát",
    "groups": ["Identita"]
  },
  {
