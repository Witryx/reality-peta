  {
    "key": "text_1c5b07d8",
    "default": "Nemovitosti v Egyptě – bydlení u Rudého moře",
    "groups": ["Egypt – vyhledávače"]
  },
  {
    "key": "text_936d8304",
    "default": "Nemovitosti v Egyptě s Petrem Pavlátem a partnerskými značkami. Druhý domov i využití majetku, s jasnými informacemi o postupu a rizicích.",
    "groups": ["Egypt – vyhledávače"]
  },
  {
    "key": "text_4edfdf5f",
    "default": "Egypt · srozumitelně a osobně",
    "groups": ["Egypt"]
  },
  {
    "key": "text_e9ad6159",
    "default": "Nejdřív otázky. Potom rozhodnutí.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_53fe14fd",
    "default": "Společně si ujasníme, proč o nemovitosti v Egyptě přemýšlíte, jaký máte rozpočet a co od ní očekáváte.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_592aa94",
    "default": "Druhý domov",
    "groups": ["Egypt"]
  },
  {
    "key": "text_eba53b85",
    "default": "Pro vlastní pobyty, čas s rodinou nebo delší zimní měsíce u moře. Důležitá je lokalita i každodenní zázemí.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_6e6c9cfc",
    "default": "Využití majetku",
    "groups": ["Egypt"]
  },
  {
    "key": "text_596eb72d",
    "default": "Projdeme možnosti pronájmu, správu a související výdaje. Výnos ani růst hodnoty nejsou zaručené.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_7a25e21b",
    "default": "Jasný postup",
    "groups": ["Egypt"]
  },
  {
    "key": "text_e69c3600",
    "default": "S partnery probereme dostupnou nabídku, právní režim vlastnictví, poplatky, kurzová rizika a správu na místě.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_42789672",
    "default": "Vybrané nabídky",
    "groups": ["Egypt"]
  },
  {
    "key": "text_7d5b8cb2",
    "default": "Nemovitosti u Rudého moře",
    "groups": ["Egypt"]
  },
  {
    "key": "text_b27db081",
    "default": "Přehled aktuálních možností. Každou nabídku projdeme osobně, včetně právního režimu vlastnictví a provozních nákladů.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_2c480182",
    "default": "Jde o ukázkové nabídky — konkrétní a ověřené nemovitosti doplníme podle aktuální dostupnosti od partnerů. Aktuální možnosti rád proberu osobně.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_db58642b",
    "default": "Kontakt pro Egypt",
    "groups": ["Egypt"]
  },
  {
    "key": "text_a253e3a6",
    "default": "Co vás láká k moři?",
    "groups": ["Egypt"]
  },
  {
    "key": "text_457358a",
    "default": "Napište mi, co hledáte. Probereme možnosti i otázky, které je dobré si položit před koupí.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_2c891d4f",
    "default": "WhatsApp pro Egypt:",
    "groups": ["Egypt"]
  },
  {
    "key": "text_b0787ed6",
    "default": "Pro kontakt na egyptském čísle prosím využijte WhatsApp. Komunikace přes WhatsApp je zdarma.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_cecc80d9",
    "default": "Probrat nabídku v Egyptě",
    "groups": ["Egypt"]
  },
  {
    "key": "text_9458cf88",
    "default": "Petr Pavlát reality. Prodej, koupě a pronájem napříč Českem a pomoc s nemovitostmi v Egyptě.",
    "groups": ["Úvodní stránka – vyhledávače"]
  },
  {
    "key": "text_41e04177",
    "default": "Prodej · Koupě · Pronájem",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_5b6a42a7",
    "default": "Co bude váš",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_eefea666",
    "default": "další domov?",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_1837dbc1",
    "default": "Možná ho hledáte. Možná se s tím současným loučíte. Pojďme si říct, co právě řešíte — a najít další krok, který vám dává smysl.",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_8b04a3a9",
    "default": "Zjistit cenu nemovitosti zdarma",
    "groups": ["Úvodní stránka", "Navigace", "Články"]
  },
  {
    "key": "text_3b0037a3",
    "default": "Prohlédnout nabídku",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_ba8ae35",
    "default": "Reality šité na",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_7dcdd54f",
    "default": "míru vaší situace.",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_a192d499",
    "default": "Každá nemovitost má svůj příběh.",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_f0fa3fca",
    "default": "A každý člověk svou situaci.",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_b7c08aa3",
    "default": "Prodáváte, kupujete, pronajímáte nebo dědíte? Řešíte složitou životní situaci, nebo chcete svůj majetek lépe využít a zhodnotit?",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_9563ace",
    "default": "Pomohu vám zorientovat se v možnostech a otevřeně říct, co dává smysl. I při exekuci nebo tlaku kolem majetku. Citlivě, bez hodnocení a bez nátlaku — a podle potřeby s pomocí odborníků.",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_18f12d7c",
    "default": "Probrat moji situaci",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_572bd7bb",
    "default": "Vše transparentně s osobním přístupem od A do Z",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_7c9b5dda",
    "default": "Reálná cena podle skutečných prodejů a exkluzivita",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_4957ac49",
    "default": "Právní a hypoteční servis pod jednou střechou",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_88145f6",
    "default": "Aktuální nabídka",
    "groups": ["Úvodní stránka"]
  },
  {
    "key": "text_3d45d8b1",
    "default": "Nemovitosti v Česku, které právě hledají nové majitele",
    "groups": ["Úvodní stránka"]
  },
