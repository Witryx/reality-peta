  },
  {
    "key": "text_edb8f946",
    "default": "Nastavení",
    "groups": ["Cookies"]
  },
  {
    "key": "text_c8504116",
    "default": "Více o cookies",
    "groups": ["Cookies"]
  },
  {
    "key": "text_43d4a68e",
    "default": "Stručně a srozumitelně: co tyto technologie dělají a co si můžete zvolit.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_6ac3c03a",
    "default": "Co jsou cookies?",
    "groups": ["Cookies"]
  },
  {
    "key": "text_794d61e4",
    "default": "Cookies jsou malé textové soubory nebo obdobné technologie, které web při návštěvě ukládá nebo čte ve vašem zařízení či prohlížeči.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_16456579",
    "default": "K čemu slouží?",
    "groups": ["Cookies"]
  },
  {
    "key": "text_97ae2de2",
    "default": "Pomáhají webu správně fungovat, pamatovat si vaše nastavení, obecně měřit návštěvnost a zájem o obsah a podle uděleného souhlasu vyhodnocovat marketing a reklamy.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_e806fdea",
    "default": "Jsou potřeba pro fungování webu a uložení vaší volby. Jsou vždy aktivní a nevyžadují souhlas.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_f63c8921",
    "default": "Pomáhají mi v obecné a anonymní podobě porozumět návštěvnosti a tomu, které informace lidi zajímají. Do udělení souhlasu jsou vypnuté.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_3eb4e4a4",
    "default": "Pomáhají vyhodnotit účinnost reklam a zobrazovat relevantnější sdělení. Do udělení souhlasu jsou vypnuté.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_3555949a",
    "default": "Externí nástroje",
    "groups": ["Cookies"]
  },
  {
    "key": "text_78c80172",
    "default": "Po vašem souhlasu může web využít Google Analytics, Google Tag Manager, Google Ads nebo Meta Pixel. Marketingový souhlas také umožní načíst Google Mapy, YouTube / Vimeo a virtuální prohlídky Matterport. Jejich poskytovatelé pak mohou související údaje zpracovávat podle svých podmínek. Před souhlasem se tyto nástroje neaktivují.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_592360ae",
    "default": "Volbu máte pod kontrolou",
    "groups": ["Cookies"]
  },
  {
    "key": "text_305eb48c",
    "default": "Souhlas můžete kdykoli změnit nebo odvolat přes odkaz „Nastavení cookies“ v patičce. Zavření tohoto okna vaši volbu nijak nemění.",
    "groups": ["Cookies"]
  },
  {
    "key": "text_610fc62c",
    "default": "Zavřít informace",
    "groups": ["Cookies"]
  },
  {
    "key": "text_eeda464d",
    "default": "Ilustrační fotografie, ne konkrétní nabídka",
    "groups": ["Egypt"]
  },
  {
    "key": "text_791d3fc7",
    "default": "DALŠÍ HORIZONT · EGYPTSKO ČESKÁ REALITY",
    "groups": ["Egypt"]
  },
  {
    "key": "text_b773a070",
    "default": "Nemovitosti v Egyptě",
    "groups": ["Egypt"]
  },
  {
    "key": "text_b0f8d4ec",
    "default": "Vaše místo",
    "groups": ["Egypt"]
  },
  {
    "key": "text_a583c3eb",
    "default": "u Rudého moře.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_fca12a28",
    "default": "Druhý domov u moře, místo pro vlastní pobyt nebo příležitost ke zhodnocení vašich prostředků.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_f5f4e7aa",
    "default": "Ve spolupráci s prověřenými partnerskými značkami vám pomáhám se zprostředkováním koupě i pronájmu apartmánu v Egyptě. Pomůžeme vám zorientovat se na místním trhu, prověřit vybranou nemovitost a v případě potřeby zajistit také její dovybavení nebo rekonstrukci podle vašich představ.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_766a8e44",
    "default": "Celým procesem vás provedeme přehledně v češtině a s dostatkem prostoru pro všechny vaše otázky. Hurghadu dobře známe a chceme, abyste se zde dokázali rychle zorientovat a cítili se jako doma.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_ab0562ff",
    "default": "Právní podporu máme k dispozici přímo na místě, a to v českém i arabském jazyce.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_2eda435b",
    "default": "Vy si vyberete. My nemovitost prověříme a pomůžeme vám celý proces bezpečně realizovat.",
    "groups": ["Egypt"]
  },
  {
    "key": "text_bf353012",
    "default": "Probrat možnosti",
    "groups": ["Egypt", "Společné sekce"]
  },
  {
    "key": "text_bfb1d53a",
    "default": "Energetická náročnost",
    "groups": ["Energetická třída"]
  },
  {
    "key": "text_671fc9cc",
    "default": "Vypracováváme pro vás energetickou hodnotu.",
    "groups": ["Energetická třída"]
  },
  {
    "key": "text_a74b39dd",
    "default": "Energetická třída zatím není uvedena.",
    "groups": ["Energetická třída"]
  },
  {
    "key": "text_8d0ca1ae",
    "default": "Do dodání průkazu uvádíme třídu G. Skutečnou energetickou náročnost doplníme po jeho vypracování.",
    "groups": ["Energetická třída"]
  },
